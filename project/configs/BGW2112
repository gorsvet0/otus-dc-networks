! Command: show running-config
! device: BGW2112 (vEOS-lab, EOS-4.36.1F)
!
! boot system flash:/vEOS-lab.swi
!
no aaa root
!
no service interface inactive port-id allocation disabled
!
transceiver qsfp default-mode 4x10G
!
service routing protocols model multi-agent
!
hostname BGW2112
!
spanning-tree mode mstp
!
system l1
   unsupported speed action error
   unsupported error-correction action error
!
vrf instance TENANT
!
interface Ethernet1
   description DCI_TO_WAN_CORE
   no switchport
   ip address 172.16.4.1/30
   bfd interval 1000 min-rx 1000 multiplier 3
   ip ospf area 0.0.0.0
!
interface Ethernet2
   shutdown
!
interface Ethernet3
   description TO_SP21
   no switchport
   ip address 10.12.1.5/30
   bfd interval 1000 min-rx 1000 multiplier 3
   ip ospf network point-to-point
   ip ospf area 0.0.0.0
!
interface Ethernet4
   description TO_SP22
   no switchport
   ip address 10.12.2.5/30
   bfd interval 1000 min-rx 1000 multiplier 3
   ip ospf network point-to-point
   ip ospf area 0.0.0.0
!
interface Ethernet5
!
interface Ethernet6
!
interface Ethernet7
!
interface Ethernet8
!
interface Loopback1
   description UNDERLAY_VTEP
   ip address 10.2.112.1/32
   ip ospf area 0.0.0.0
!
interface Loopback2
   description DCI_VTEP_SOURCE
   ip address 10.2.112.2/32
!
interface Management1
!
interface Vxlan1
   vxlan source-interface Loopback1
   vxlan udp-port 4789
   vxlan vrf TENANT vni 9999
!
ip routing
ip routing vrf TENANT
!
router bgp 65000
   router-id 10.2.112.1
   no bgp default ipv4-unicast
   neighbor SPINES peer group
   neighbor SPINES remote-as 65000
   neighbor SPINES update-source Loopback1
   neighbor SPINES send-community extended
   neighbor 10.2.1.1 peer group SPINES
   neighbor 10.2.2.1 peer group SPINES
   neighbor 172.16.2.1 remote-as 65001
   neighbor 172.16.2.1 local-as 65002 no-prepend replace-as
   neighbor 172.16.2.1 ebgp-multihop 2
   neighbor 172.16.2.1 send-community extended
   !
   address-family evpn
      neighbor SPINES activate
      neighbor 172.16.2.1 activate
   !
   vrf TENANT
      rd 10.2.112.1:9999
      route-target import evpn 1:9999
      route-target export evpn 1:9999
!
router ospf 1
   router-id 10.2.112.1
   bfd default
   passive-interface default
   no passive-interface Ethernet1
   no passive-interface Ethernet3
   no passive-interface Ethernet4
   max-lsa 12000
!
end
! Command: show running-config
! device: LF111 (vEOS-lab, EOS-4.36.1F)
!
! boot system flash:/vEOS-lab.swi
!
no aaa root
!
no service interface inactive port-id allocation disabled
!
transceiver qsfp default-mode 4x10G
!
service routing protocols model multi-agent
!
hostname LF111
!
spanning-tree mode mstp
!
system l1
   unsupported speed action error
   unsupported error-correction action error
!
vlan 10
   name VLAN10_STRETCH
!
vlan 20
   name VLAN20_STRETCH
!
vlan 40
   name VLAN40_LEGACY_MIGRATION
!
vrf instance TENANT
!
interface Port-Channel10
   description ESI_cl110_VLAN10
   switchport access vlan 10
   !
   evpn ethernet-segment
      identifier 0000:0000:0000:0010:0001
   lacp system-id 0000.0000.0010
   spanning-tree portfast edge
!
interface Port-Channel20
   description ESI_cl120_VLAN20
   switchport access vlan 20
   !
   evpn ethernet-segment
      identifier 0000:0000:0000:0020:0001
   lacp system-id 0000.0000.0020
   spanning-tree portfast edge
!
interface Ethernet1
   description TO_SP11
   no switchport
   ip address 10.11.11.2/30
   bfd interval 1000 min-rx 1000 multiplier 3
   ip ospf network point-to-point
   ip ospf area 0.0.0.0
!
interface Ethernet2
   description TO_SP12
   no switchport
   ip address 10.11.11.6/30
   bfd interval 1000 min-rx 1000 multiplier 3
   ip ospf network point-to-point
   ip ospf area 0.0.0.0
!
interface Ethernet3
   description TO_cl110_LAG
   channel-group 10 mode active
!
interface Ethernet4
   description TO_cl120_LAG
   channel-group 20 mode active
!
interface Ethernet5
   description TO_OLD_CORE
   switchport trunk allowed vlan 40
   switchport mode trunk
!
interface Ethernet6
   description TO_OLD_SRV_DIRECT
   switchport access vlan 40
   spanning-tree portfast edge
!
interface Ethernet7
!
interface Ethernet8
!
interface Loopback1
   description UNDERLAY_VTEP
   ip address 10.1.11.1/32
   ip ospf area 0.0.0.0
!
interface Management1
!
interface Vlan10
   description ANYCAST_GW_VLAN10
   vrf TENANT
   ip address virtual 192.168.10.1/24
!
interface Vlan20
   description ANYCAST_GW_VLAN20
   vrf TENANT
   ip address virtual 192.168.20.1/24
!
interface Vlan40
   description ANYCAST_GW_VLAN40
   vrf TENANT
   ip address virtual 192.168.40.1/24
!
interface Vxlan1
   vxlan source-interface Loopback1
   vxlan udp-port 4789
   vxlan vlan 10 vni 10010
   vxlan vlan 20 vni 10020
   vxlan vlan 40 vni 10040
   vxlan vrf TENANT vni 9999
!
ip virtual-router mac-address 00:1c:73:00:11:11
!
ip routing
ip routing vrf TENANT
!
router bgp 65000
   router-id 10.1.11.1
   no bgp default ipv4-unicast
   neighbor SPINES peer group
   neighbor SPINES remote-as 65000
   neighbor SPINES update-source Loopback1
   neighbor SPINES send-community extended
   neighbor 10.1.1.1 peer group SPINES
   neighbor 10.1.2.1 peer group SPINES
   !
   vlan-aware-bundle TENANT_VLANS
      rd 10.1.11.1:10010
      route-target both 1:10010
      route-target both 1:10020
      route-target both 1:10040
      redistribute learned
      vlan 10,20,40
   !
   address-family evpn
      neighbor SPINES activate
   !
   vrf TENANT
      rd 10.1.11.1:9999
      route-target import evpn 1:9999
      route-target export evpn 1:9999
      redistribute connected
!
router ospf 1
   router-id 10.1.11.1
   bfd default
   passive-interface default
   no passive-interface Ethernet1
   no passive-interface Ethernet2
   max-lsa 12000
!
end